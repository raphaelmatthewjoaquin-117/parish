# Local app defaults; do not use these values in production.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# SQL Server (local development)
DB_AUTH=sql
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ParishDB
DB_USER=your_local_sql_login
DB_PASSWORD=your_local_sql_password
DB_TRUST_SERVER_CERTIFICATE=true

# Optional Supabase connection for local testing.
# Use a non-owner, non-superuser, NOBYPASSRLS login with no role memberships.
# Keep the connection string server-side; never expose it with a VITE_ prefix.
DATABASE_URL=
# For PostgreSQL-only mode, set every provider below to postgres.
IDENTITY_DATABASE=sqlserver
EVENTS_DATABASE=sqlserver
CONTENT_DATABASE=sqlserver
CERTIFICATE_DATABASE=sqlserver
SERVICE_DATABASE=sqlserver
OPERATIONS_DATABASE=sqlserver
SACRAMENTAL_DATABASE=sqlserver
# Optional CA PEM from Supabase Database Settings > SSL Configuration.
# Use a path (recommended) or set DATABASE_SSL_CA with literal \n between PEM lines.
DATABASE_SSL_CA_PATH=
DATABASE_SSL_CA=

# Admin authentication (use a random value of at least 32 characters)
ADMIN_TOKEN=replace_with_a_random_local_value
ADMIN_TOKEN_SIGNING_SECRET=replace_with_a_different_random_value_at_least_32_characters

# Optional localhost-only Admin preview when the database is unavailable.
# Put real values in .env.local (gitignored); this is disabled outside development.
# Start the API with `npm run server:local` to load this mode.
LOCAL_ADMIN_USERNAME=localadmin
LOCAL_ADMIN_PASSWORD=replace_with_a_random_password_at_least_16_characters

# Optional email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Upload storage (Supabase Storage is required in PostgreSQL-only production mode.)
# Create parish-public-assets as a public bucket and parish-private-documents as private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=parish-public-assets
SUPABASE_PRIVATE_BUCKET=parish-private-documents
# Azure settings are only for legacy SQL Server deployments.
# Example values:
# AZURE_STORAGE_ACCOUNT_NAME=parishuploads
# AZURE_STORAGE_ACCOUNT_KEY=your_account_key
# AZURE_STORAGE_CONTAINER_NAME=uploads
# PUBLIC_UPLOAD_BASE_URL=https://parishuploads.blob.core.windows.net/uploads
# OR use a full connection string instead of the key pair:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# If left empty, the server keeps using the local uploads/ folder.
PUBLIC_UPLOAD_BASE_URL=
UPLOADS_DIR=uploads
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=uploads
AZURE_STORAGE_CONNECTION_STRING=
